# Maple · Minecraft 英语伴学
# 复制本文件为 .env 后再填写。不要把 .env 提交到 Git，也不要在群里发送 Access Token。
#
# 豆包免费试用（同学向）：
# 1. 打开火山引擎控制台 https://console.volcengine.com/speech/app
# 2. 用手机号注册并创建一个语音应用，记下 App ID 和 Access Token
# 3. 在该应用里开通「端到端实时语音大模型」（新账号控制台一般有免费试用额度，以页面显示为准）
# 4. 把下面两项填进 .env，其余可保持默认

# 必填。火山引擎语音应用的 App ID（纯数字）
DOUBAO_APP_ID=
# 必填。该应用的 Access Token。这是密钥，只放在本机 .env
DOUBAO_ACCESS_TOKEN=

# 以下为火山引擎文档中的固定值或公开默认值，不是你的个人密钥
# App Key 固定值见「端到端实时语音大模型 API 接入文档」
DOUBAO_APP_KEY=PlgvMymc7f3tQnJ6
DOUBAO_RESOURCE_ID=volc.speech.dialog
DOUBAO_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue

# 模型版本：O2.0 = 1.2.1.1（试用常见），SC2.0 = 2.2.0.0
DOUBAO_MODEL=1.2.1.1
# 音色。可在文档的发音人列表里更换
DOUBAO_SPEAKER=zh_female_vv_jupiter_bigtts

# 设为 1 时不连接豆包，只用本地排练（没有试用额度时先看界面）
DOUBAO_MOCK=0

# 本机网页端口
MAPLE_PORT=8787
